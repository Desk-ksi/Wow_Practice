<header style = "color: #fffacd; border-bottom: 1px solid #383835;">
  <nav class="navbar navbar-expand" style="background-color: #fffacd; --bs-navbar-brand-color: #383835; --bs-navbar-color: #383835;">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">Wow!Kitchen</a>
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "マイページ", "#", class: "btn btn-warning" %>
          </li>
          <li class="nav-item">
            <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete, turbo_confirm: "ログアウトしますか？" }, class: "btn btn-warning" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "ログイン", new_user_session_path, class: "btn btn-warning" %>
          </li>
        <% end %>
      </ul>
    </div>
  </nav>
</header>